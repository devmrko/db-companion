# Java properties 형식. 복수 월렛은 JSON 배열 전체를 추가 따옴표로 감싸지 않습니다.
# ORACLE_WALLET_PATHS=["/absolute/path/to/Wallet_DB1","/absolute/path/to/Wallet_DB2"]
# 복수 설정이 비어 있으면 아래 기존 단일 설정을 사용합니다.
# 기존 ORACLE_WALLET_PATH에 JSON 배열을 지정하는 형식도 지원합니다.
ORACLE_WALLET_PATH=/absolute/path/to/Wallet_MYDB
# REST API test: trusted HTTPS ORDS base URL per database name shown in the app.
# DB credentials are never reused for HTTP authentication. Restart after changes.
# ORDS_TEST_ENDPOINTS={"EXAMPLE_DB":"https://example.invalid/ords/"}
# Wallet과 해당 TNS 서비스는 로그인 화면에서 선택합니다. 목록 변경은 앱 재시작 시 반영합니다.
# Select AI 테스트의 생성 SQL 실행 제한 (초, 1~3600). 변경 후 앱을 재시작하세요.
# AI 생성 시간이나 DB 프로필 옵션은 변경하지 않습니다.
SELECT_AI_SQL_TIMEOUT_SECONDS=300
# Select AI 테스트의 SQL 생성·SHOWPROMPT·AI 검토 제한 (초, 1~3600).
# SQL 실행 제한과 별도이며 DB 프로필은 변경하지 않습니다. 변경 후 앱을 재시작하세요.
SELECT_AI_GENERATE_TIMEOUT_SECONDS=300
